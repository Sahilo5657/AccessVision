{
  "name": "AccessVision – Accessible Reader & Assistant",
  "short_name": "AccessVision",
  "description": "Accessible Progressive Web App for visually impaired users with full content reading, high-contrast modes, and warm natural English & Urdu voices.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#090d16",
  "theme_color": "#2563eb",
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "accessibility",
    "utilities",
    "education",
    "news"
  ],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Read Content",
      "short_name": "Read",
      "description": "Start reading the current article aloud",
      "url": "/?action=read",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Urdu Mode (اردو)",
      "short_name": "اردو",
      "description": "Switch to Urdu language reader and voice",
      "url": "/?action=urdu",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "High Contrast",
      "short_name": "Contrast",
      "description": "Toggle high contrast mode",
      "url": "/?action=contrast",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
